{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "fnm exec --using=default ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
